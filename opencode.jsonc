{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "agents": {
    // Режим "Билд" — полноценное кодирование: правки файлов, команды
    "build": {
      "description": "Кодирование и правки: полный доступ к файлам и командам",
      "mode": "primary",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" }
      ]
    },
    // Режим "План" — только чтение и планирование, без правок файлов
    "plan": {
      "description": "Исследование и планирование: без изменения файлов проекта",
      "mode": "primary",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "ask" }
      ]
    }
  }
}
